{
  "name": "qrcode-generator-app",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "eas build --profile development --platform ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "doctor": "pnpm dlx expo-doctor@latest",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:android:dev": "eas build --profile development --platform android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "pnpm run test --watch",
    "test:ci": "pnpm run test --coverage"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@gorhom/bottom-sheet": "^5.0.5",
    "expo": "~54.0.35",
    "expo-blur": "~14.1.4",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~14.0.1",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "iconsax-react-native": "^0.0.8",
    "nativewind": "^4.1.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-error-boundary": "^4.0.13",
    "react-native": "0.81.5",
    "react-native-barcode-svg": "^0.0.15",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-styled": "^0.4.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "^4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwind-variants": "^0.2.1"
